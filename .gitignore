# ==========================================
# DevFlow - Unified Full-Stack .gitignore
# ==========================================

# ------------------------------------------
# Python & Django Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Django local database & cache
*.sqlite3
db.sqlite3
db.sqlite3-journal

# Media & Static assets generated locally
media/
staticfiles/

# Python coverage & testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ------------------------------------------
# Node.js & Next.js Frontend
# ------------------------------------------
node_modules/
.next/
out/
build/
dist/

# Next.js telemetry & cache
.pnpm-store/
.yarn/cache/
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.local

# ------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# IDE config
.idea/
.vscode/
*.swp
*.swo
